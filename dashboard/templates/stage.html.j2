{% extends "base.html.j2" %}
{% block title %}{{ stage.stage }}{% endblock %}
{% block body %}
<p class="crumb"><a href="../index.html">Curriculum data</a> · {{ stage.stage }}</p>
<h1>{{ stage.stage }} <span class="muted">{{ stage.title }}</span></h1>

<section id="changelog"></section>

{% if compare %}
<h2>Compare versions</h2>
<form class="versions" id="versions">
  <div class="side">
    <label><span class="side-label">Old</span>
      <select name="old">{% for version in versions[:-1] %}<option>{{ version }}</option>{% endfor %}</select>
    </label>
    <p class="downloads" id="downloads-old"></p>
  </div>
  <div class="arrow" aria-hidden="true">→</div>
  <div class="side">
    <label><span class="side-label">New</span>
      <select name="new">{% for version in versions[1:] %}<option>{{ version }}</option>{% endfor %}</select>
    </label>
    <p class="downloads" id="downloads-new"></p>
  </div>
</form>
<label class="toggle"><input type="checkbox" id="show-unchanged"> Show unchanged traces and question types</label>
{% endif %}

<div id="pair"><noscript><p class="warn">This page needs JavaScript to show the traces.</p></noscript></div>

<script type="application/json" id="dashboard-data">{{ data }}</script>
<script>
{{ script }}
</script>
{% endblock %}
